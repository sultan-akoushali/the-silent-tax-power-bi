{
  "name": "Silent Tax",
  "dataColors": ["#C2410C", "#1E3A5F", "#0F766E", "#9CA3AF", "#D97706", "#6D28D9", "#BE123C", "#65A30D"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#C2410C",
  "good": "#0F766E",
  "neutral": "#9CA3AF",
  "bad": "#C2410C",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#4B5563" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E7E1D6" } }, "radius": 10 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F1EA" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F1EA" } }, "transparency": 0 }]
      }
    }
  }
}
